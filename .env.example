# Copy to .env.local and fill in. Never commit .env.local.

# ---- Supabase (required) ----
# Project Settings > API. The anon key is public and safe in the browser;
# the service role key bypasses RLS entirely and must stay server-side only.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ---- Scheduled sync (required in production) ----
# Any long random string, e.g. `openssl rand -hex 32`.
# Set the SAME value in Vercel project env vars: Vercel Cron sends it as
# `Authorization: Bearer $CRON_SECRET` automatically.
# Without it, /api/cron/auto-sync refuses every scheduler request — a
# signed-in user's browser can still trigger a sync, but only for their own
# businesses.
CRON_SECRET=""

# ---- Error monitoring (optional) ----
# Leave the DSN empty to disable Sentry entirely; the app runs unchanged.
# DSN: sentry.io > Project > Settings > Client Keys.
NEXT_PUBLIC_SENTRY_DSN=""

# Only needed to upload source maps at build time, so stack traces point at
# real code instead of minified bundles. Build-time only, never sent to the
# browser. Auth token: sentry.io > Settings > Auth Tokens (scope: project:releases).
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
